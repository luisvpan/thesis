{
  "name": "dataflow-execution-environment",
  "version": "0.0.1",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --filter thesis-frontend dev",
    "build": "bun run --filter thesis-frontend build",
    "test": "bun run --filter @dataflow/interpreter test && bun run --filter thesis-frontend test",
    "typecheck": "bun tsc --noEmit",
    "lint": "echo 'Lint not configured'",
    "format": "echo 'Format not configured'"
  },
  "devDependencies": {
    "@types/bun": "^1.3.10",
    "concurrently": "^9.1.2",
    "typescript": "^5.9.3"
  }
}