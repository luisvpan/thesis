# URL base del API Elysia. Si no se define, el cliente Eden usa `window.location.origin`
# (en dev, Vite hace proxy de `/api` → http://127.0.0.1:3000).
# VITE_API_URL=http://127.0.0.1:3000

# Socket (Python / otro backend) — ver SocketContext
# VITE_SOCKET_URL=http://127.0.0.1:4000

# WebSocket visión (por defecto mismo host que la página + /ws/vision)
# VITE_VISION_WS_URL=ws://127.0.0.1:3000/ws/vision
