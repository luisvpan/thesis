# Base del relé FastAPI (opcional). Sin definir, las peticiones usan el mismo origen que la página
# y en dev Vite hace proxy de `/api` → http://127.0.0.1:8765.
# VITE_API_URL=http://127.0.0.1:8765

# Socket (Python / otro backend) — ver SocketContext
# VITE_SOCKET_URL=http://127.0.0.1:4000

# WebSocket visión (por defecto mismo host que la página + /ws/vision)
# VITE_VISION_WS_URL=ws://127.0.0.1:8765/ws/vision
