{
  "name": "@dataflow/http-api",
  "version": "0.0.1",
  "type": "module",
  "main": "./src/main.ts",
  "exports": {
    "./server": "./src/server.ts",
    ".": "./src/index.ts"
  },
  "dependencies": {
    "@dataflow/compiler": "workspace:*",
    "@dataflow/runtime": "workspace:*",
