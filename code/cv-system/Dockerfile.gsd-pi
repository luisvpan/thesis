# GSD-2 agent environment for the CV system
FROM node:24-slim

RUN apt-get update && apt-get install -y \
  ca-certificates git bash curl unzip ripgrep

# Install uv (Python package manager)
RUN curl -LsSf https://astral.sh/uv/install.sh | sh

# Install GSD-2
RUN corepack enable
ENV SHELL=/bin/bash
ENV ENV=~/.bashrc
RUN pnpm setup
ENV PNPM_HOME="/root/.local/share/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
RUN pnpm i -g --dangerously-allow-all-builds gsd-pi

RUN git config --global --add safe.directory '/thesis' && \
  git config --global --add safe.directory '/thesis/code' && \
  git config --global --add safe.directory '/thesis/code/cv-system'

ENV PATH="/root/.local/bin:$PATH"
ENV GIT_DISCOVERY_ACROSS_FILESYSTEM=1

WORKDIR /thesis/code/cv-system

ENTRYPOINT ["bash"]